# Server environment for the G1 API (copy to .env on the server only, chmod 600).
# No secret value here: fill ANTHROPIC_API_KEY on the server.
ANTHROPIC_API_KEY=
# Allowed web origins, comma separated (e.g. the portfolio site).
CORS_ORIGINS=
# Questions per visitor and per day / per day for everybody.
LIMIT_PER_VISITOR=10
LIMIT_PER_DAY=300
# Maximum length of a question, and simultaneous engine calls.
MAX_QUESTION_CHARS=1000
MAX_CONCURRENT=2
# 1 = the API runs behind Caddy: the visitor IP is the last x-forwarded-for entry.
# Leave unset if the API is exposed directly (the header is then ignored).
BEHIND_PROXY=1
