# Copy this file to .env and fill in your own key. Never commit .env (it is in .gitignore).

# LLM provider: anthropic (Claude Haiku, default) or groq (gpt-oss-120b, free tier)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# GROQ_API_KEY=            # only if LLM_PROVIDER=groq

# 0 = do not store the questions of visitors (use 0 on a public server).
# Leave it unset for local evaluations: LLM answers are then cached in data/eval/.
REWRITE_CACHE=0

# Optional usage limits for the public demo (defaults: 10 and 300)
LIMIT_PER_VISITOR=10
LIMIT_PER_DAY=300
